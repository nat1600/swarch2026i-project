# Example Environment Configuration
# Copiar este archivo a .env.local y completar con tus credenciales

# ====== MERCADOPAGO CONFIGURATION ======
# Obtener en: https://www.mercadopago.com.ar/developers/panel
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REPLACE_WITH_YOUR_TOKEN
MERCADOPAGO_WEBHOOK_TOKEN=REPLACE_WITH_YOUR_WEBHOOK_TOKEN

# ====== DATABASE CONFIGURATION ======
# Para PostgreSQL local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/payment_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Para PostgreSQL en Docker
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/payment_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# ====== SPRING BOOT CONFIGURATION ======
SERVER_PORT=8005
SPRING_APPLICATION_NAME=payment-service
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_ARQUISOFT_PAYMENT=DEBUG

# ====== ACTUATOR CONFIGURATION (Monitoreo) ======
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info
